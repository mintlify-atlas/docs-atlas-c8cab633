  "keyFeatures": [
    "Multi-company accounting with isolated books per empresa",
    "Dynamic journal books (libros diarios) with ACTIVO/INACTIVO states",
    "Double-entry journal entry recording via stored procedures",
    "Ledger posting (mayorización) with date-range filtering",
    "Trial balance (balance de comprobación) with auto-balancing validation",
    "Income statement (estado de resultados) for revenue/expense accounts",
    "Balance sheet (balance general) for assets, liabilities, and equity",
    "Inventory control via Kardex with FIFO cost averaging",
    "Kardex movement types: INVENTARIO_INICIAL, COMPRA, VENTA, DEV_COMPRA, DEV_VENTA",
    "IVA (13%) handling for Kardex pricing (included or excluded)",
    "User authentication tied to empresa with admin role",
    "Supabase PostgreSQL backend with connection pooling"
  ],
  "publicApiSurface": [
    "POST /api/login",
    "POST /api/registro",
    "GET /api/health",
    "GET /api/empresa",
    "PUT /api/empresa/:idEmpresa",
