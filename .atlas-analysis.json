    "GET /api/historial",
    "GET /api/mayorizacion",
    "GET /api/balance-comprobacion",
    "GET /api/estado-resultados",
    "GET /api/balance-cuentas",
    "GET /api/kardex-articulos/:id_empresa",
    "POST /api/kardex",
    "GET /api/kardex/:filtro/:id_empresa",
    "DELETE /api/kardex/:id_movimiento/:id_empresa"
  ]
